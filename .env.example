# Application
APP_NAME=OVERWATCHER
APP_ENV=development
APP_PORT=8000
SECRET_KEY=final_year_project_overwatcher

# Database (PostgreSQL)
DATABASE_URL=postgresql://overwatcher:overwatcher@localhost:5432/overwatcher_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
LDAP_SERVER=ldap://your-hospital-ldap-server
LDAP_BASE_DN=dc=hospital,dc=local

# Trust Memory
DEFAULT_TRUST_SCORE=0.5
TRUST_DECAY_FACTOR=0.995
TRUST_REWARD_ALPHA=0.05
TRUST_PENALTY_BETA=0.15

# Risk Scoring Weights
RISK_WEIGHT_REVERSIBILITY=0.5
RISK_WEIGHT_SENSITIVITY=0.35
RISK_WEIGHT_URGENCY=0.15

# Policy Engine Thresholds
THRESHOLD_BLOCK_CONSISTENCY=0.9
THRESHOLD_HUMAN_APPROVAL_RISK=0.85
THRESHOLD_HUMAN_APPROVAL_TRUST=0.4
THRESHOLD_ANOMALY_BLOCK=0.9
THRESHOLD_ANOMALY_HUMAN=0.7
THRESHOLD_STEPUP_RISK=0.5
THRESHOLD_STEPUP_ANOMALY=0.4

# Behavior Analyzer
BEHAVIOR_ANALYZER_BACKEND=hmm
# Options: hmm | transformer
BEHAVIOR_SEQUENCE_WINDOW=10

# Consistency Checker
CONSISTENCY_EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
CONSISTENCY_SIMILARITY_THRESHOLD=0.75

# Audit Logger
AUDIT_LOG_TABLE=audit_logs
